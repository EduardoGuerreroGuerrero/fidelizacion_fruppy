# ==========================================================================
# Plantilla de variables de entorno — SaaS Fidelización Fruppy
# Copiar a .env y rellenar SOLO en local. NUNCA commitear .env real.
# Los valores aquí son placeholders sin ningún secreto real.
# ==========================================================================

# ---- Entorno ----
APP_ENV=local                      # local | staging | production
APP_NAME=fruppy-loyalty
APP_URL=http://localhost:3000

# ---- Supabase (Fase 1+) ----
# URL del proyecto Supabase (local: http://localhost:54321 con supabase CLI)
NEXT_PUBLIC_SUPABASE_URL=
# Clave anon/publishable — segura para el navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave service_role — SOLO servidor, NUNCA en NEXT_PUBLIC_* ni en el navegador
SUPABASE_SERVICE_ROLE_KEY=
# Connection string directo a Postgres para migraciones/scripts
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ---- QR / tarjetas ----
# Secreto para firmar tokens de tarjeta (generar con: python -c "import secrets; print(secrets.token_hex(32))")
CARD_TOKEN_SIGNING_SECRET=

# ---- Apple Wallet (Fase 6, opcional hasta tener credenciales) ----
APPLE_WALLET_ENABLED=false
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_WWDR_CERT_PATH=
APPLE_PASS_CERT_PATH=
APPLE_PASS_KEY_PATH=
APPLE_PASS_KEY_PASSWORD=

# ---- Google Wallet (Fase 6, opcional hasta tener credenciales) ----
GOOGLE_WALLET_ENABLED=false
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_ID=
# Ruta al JSON de service account (fuera del repo) o contenido en gestor de secretos
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Observabilidad ----
LOG_LEVEL=info                     # debug | info | warn | error
SENTRY_DSN=
